DATABASE_URL="postgresql://dga:dga_secret@127.0.0.1:5433/dga_analysis?schema=public"
PORT=3001

# Required. Generate a random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" once this deployment is behind HTTPS (required for session
# cookies to work on a public VPS - see DEPLOYMENT.md).
COOKIE_SECURE=false

# Set to "1" if running behind a reverse proxy (nginx/Caddy) so Express
# trusts X-Forwarded-* headers for secure cookie detection.
TRUST_PROXY=0

# Only needed when the frontend is hosted separately from this API (e.g.
# frontend on Vercel, backend here on Render) - the frontend's origin, so
# CORS can allow credentialed cross-origin requests. Leave unset for a
# combined/same-origin deployment.
CORS_ORIGIN=

# Set to "none" only for a cross-origin deployment (see CORS_ORIGIN above);
# requires COOKIE_SECURE=true, since browsers reject SameSite=None cookies
# that aren't Secure. Leave unset (defaults to "lax") for same-origin.
COOKIE_SAMESITE=

# Directory backups are written to and read from. Defaults to ./backups.
BACKUP_DIR=
